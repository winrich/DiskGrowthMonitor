<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <runtime>
    <!--
      GC 模式（此项仅在 app.config 生效，csproj 的 ServerGarbageCollection 属性对 net45 无效）。

      Server GC = 每个逻辑处理器一个堆，多线程分配吞吐更高；但它的代价是：
        · 内存占用明显上升（本机 8 物理核 / 16 逻辑线程 ⇒ 最多 16 个堆）；
        · 并发度不足时，跨堆引用反而拖慢回收。
      当前扫描的并行单位是「扫描根」，单盘扫描实际是单线程 ⇒ 先保持 Workstation GC。

      ⇒ 「根内并行」实施后，用同一口径实测 <gcServer enabled="true"/> 的耗时与峰值内存，
        再决定是否切换（切换只需改这一个值）。
    -->
    <gcServer enabled="false" />
    <!-- 并发（后台）GC：与 .NET Framework 默认一致，显式写出以便对照与后续调整。 -->
    <gcConcurrent enabled="true" />
  </runtime>
</configuration>
